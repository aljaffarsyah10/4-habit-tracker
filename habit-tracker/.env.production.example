# ==========================================
# HABIT TRACKER — PRODUCTION ENVIRONMENT
# ==========================================
# IMPORTANT: Generate strong random secrets before deploying.
# Do NOT commit your actual .env or .env.production file to version control.

# Node Environment
NODE_ENV=production
PORT=3000

# PostgreSQL Connection String (Supabase / Neon / Railway / AWS RDS / Self-hosted)
# Format: postgresql://[user]:[password]@[host]:[port]/[database]?schema=public&sslmode=require
DATABASE_URL="postgresql://username:strong_password@db-host.provider.com:5432/habit_tracker?schema=public&sslmode=require"

# Production Authentication Secret
# Generate a cryptographically secure 32+ character random string:
# Command: openssl rand -base64 32
AUTH_SECRET="REPLACE_WITH_GENERATED_SECURE_32_CHAR_RANDOM_SECRET"

# Production Canonical Application URL (must include https://)
NEXTAUTH_URL="https://habittracker.yourdomain.com"
AUTH_URL="https://habittracker.yourdomain.com"
